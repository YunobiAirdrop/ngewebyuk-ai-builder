<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Error - NgeWebYuk</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-white min-h-screen flex flex-col justify-center items-center p-4">
  <div class="bg-slate-900 border border-slate-800 p-8 rounded-xl max-w-md text-center">
    <h1 class="text-4xl font-extrabold text-red-500 mb-2">404</h1>
    <p class="text-slate-300 mb-6"><%= typeof message !== 'undefined' ? message : 'Terjadi Kesalahan Sistem' %></p>
    <a href="/" class="bg-indigo-600 hover:bg-indigo-500 px-4 py-2 rounded text-sm font-medium transition">Kembali ke Beranda</a>
  </div>
</body>
</html>